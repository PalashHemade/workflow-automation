# ─────────────────────────────────────────────────────────────
#  GitHub Analytics Dashboard — Environment Variables
# ─────────────────────────────────────────────────────────────
#  Copy this file to .env and fill in your own values:
#    cp .env.example .env
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection string for Prisma
# When running with Docker Compose, this is overridden automatically.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/github_analytics?schema=public"

# NextAuth.js configurations
# Generate a secret via: openssl rand -base64 32
NEXTAUTH_SECRET="replace-me-with-a-random-base64-string"
NEXTAUTH_URL="http://localhost:3000"

# Application Deployment URL (required to register webhooks automatically)
# For local development, use ngrok or a similar tunnel service.
APP_URL="http://localhost:3000"

# GitHub Developer OAuth App Credentials
# Create one at: GitHub Settings -> Developer settings -> OAuth Apps
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

# Webhook secret configured on GitHub Repository webhook
# Used to verify payload cryptographic signature integrity
GITHUB_WEBHOOK_SECRET="your-webhook-secret"

# Jira Developer OAuth 2.0 Credentials (optional)
# Create at: https://developer.atlassian.com/console/myapps/
JIRA_CLIENT_ID="your-jira-client-id"
JIRA_CLIENT_SECRET="your-jira-client-secret"
JIRA_REDIRECT_URI="http://localhost:3000/api/auth/jira/callback"

# AI Agent Framework — Groq + Llama 3.3 70B (optional)
# Get a free API key at: https://console.groq.com
GROQ_API_KEY="your-groq-api-key"
LLM_PROVIDER="groq"
LLM_MODEL="llama-3.3-70b-versatile"
