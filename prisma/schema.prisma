generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state            String?
  refresh_token_expires_in Int?
  user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                  String               @id @default(cuid())
  name                String?
  email               String?              @unique
  emailVerified       DateTime?
  image               String?
  accounts            Account[]
  engineeringProjects EngineeringProject[]
  projectMemberships  ProjectMember[]
  repositories        Repository[]
  sessions            Session[]
  userToken           UserToken?
}

model VerificationToken {
  id         String   @id @default(cuid())
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// *
///  * Custom short-lived access + rotating refresh token pair.
///  * One active pair per user at a time (userId is unique).
///  * - accessToken:  15-minute lifetime, HMAC-signed with NEXTAUTH_SECRET
///  * - refreshToken: 7-day lifetime, HMAC-signed with REFRESH_TOKEN_SECRET
///  * On every refresh, the old row is deleted and a new one is inserted.
///  * On sign-out, the row is deleted and the GitHub OAuth token is revoked.
model UserToken {
  id                    String   @id @default(cuid())
  userId                String   @unique
  accessToken           String   @unique
  refreshToken          String   @unique
  accessTokenExpiresAt  DateTime
  refreshTokenExpiresAt DateTime
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([accessToken])
  @@index([refreshToken])
}

model EngineeringProject {
  id              String               @id @default(cuid())
  name            String
  description     String?
  ownerId         String
  repositoryId    String               @unique
  primaryBranch   String               @default("main")
  defaultBranch   String               @default("main")
  archived        Boolean              @default(false)
  syncStatus      SyncStatus           @default(IDLE)
  lastSyncAt      DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  aiInsights      AIInsight[]
  owner           User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  repository      Repository           @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  epics           Epic[]
  tasks           JiraTask[]
  moduleKnowledge ModuleKnowledge[]
  pipelineRuns    PipelineRun[]
  projectEvents   ProjectEvent[]
  integrations    ProjectIntegration[]
  knowledge       ProjectKnowledge?
  members         ProjectMember[]
  metrics         ProjectMetrics?
  sprints         Sprint[]
  stories         Story[]
  syncJobs        SyncJob[]
}

model ProjectIntegration {
  id                   String              @id @default(cuid())
  provider             IntegrationProvider
  status               IntegrationStatus   @default(CONNECTED)
  config               Json?
  lastSyncAt           DateTime?
  lastSuccessfulSync   DateTime?
  lastFailure          DateTime?
  lastError            String?
  engineeringProjectId String
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  credentials          OAuthCredential[]
  pipelineRuns         PipelineRun[]
  engineeringProject   EngineeringProject  @relation(fields: [engineeringProjectId], references: [id], onDelete: Cascade)
  syncJobs             SyncJob[]

  @@unique([engineeringProjectId, provider])
}

model OAuthCredential {
  id            String              @id @default(cuid())
  provider      IntegrationProvider
  accessToken   String
  refreshToken  String?
  expiresAt     DateTime?
  accountId     String?
  accountName   String?
  integrationId String
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  integration   ProjectIntegration  @relation(fields: [integrationId], references: [id], onDelete: Cascade)
}

model ProjectMember {
  id                   String             @id @default(cuid())
  role                 String             @default("MEMBER")
  githubUsername       String?
  jiraAccountId        String?
  permissions          Json?
  engineeringProjectId String
  userId               String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  engineeringProject   EngineeringProject @relation(fields: [engineeringProjectId], references: [id], onDelete: Cascade)
  user                 User?              @relation(fields: [userId], references: [id])
}

model JiraWorkspace {
  id           String    @id @default(cuid())
  cloudId      String    @unique
  name         String
  baseUrl      String
  accessToken  String
  refreshToken String?
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Sprint {
  id        String             @id @default(cuid())
  jiraId    String             @unique
  name      String
  state     SprintState
  startDate DateTime?
  endDate   DateTime?
  projectId String
  project   EngineeringProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stories   Story[]
}

model Epic {
  id        String             @id @default(cuid())
  jiraId    String             @unique
  key       String
  summary   String
  status    String
  projectId String
  project   EngineeringProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stories   Story[]
}

model Story {
  id                String             @id @default(cuid())
  jiraId            String             @unique
  key               String
  summary           String
  description       String?
  priority          String?
  status            String
  assigneeId        String?
  sprintId          String?
  epicId            String?
  projectId         String
  tasks             JiraTask[]
  epic              Epic?              @relation(fields: [epicId], references: [id])
  project           EngineeringProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sprint            Sprint?            @relation(fields: [sprintId], references: [id])
  storyCommits      StoryCommit[]
  storyPullRequests StoryPullRequest[]
}

model StoryCommit {
  id         String            @id @default(cuid())
  storyId    String
  commitId   String
  confidence Float             @default(100.0)
  matchedBy  CorrelationMethod @default(COMMIT)
  reason     String?
  createdAt  DateTime          @default(now())
  commit     Commit            @relation(fields: [commitId], references: [id], onDelete: Cascade)
  story      Story             @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([storyId, commitId])
  @@index([storyId])
  @@index([commitId])
}

model StoryPullRequest {
  id            String            @id @default(cuid())
  storyId       String
  pullRequestId String
  confidence    Float             @default(100.0)
  matchedBy     CorrelationMethod @default(PR_TITLE)
  reason        String?
  createdAt     DateTime          @default(now())
  pullRequest   PullRequest       @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)
  story         Story             @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([storyId, pullRequestId])
  @@index([storyId])
  @@index([pullRequestId])
}

model JiraTask {
  id        String             @id @default(cuid())
  jiraId    String             @unique
  key       String
  summary   String
  issueType String
  status    String
  priority  String?
  assignee  String?
  storyId   String?
  projectId String
  project   EngineeringProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  story     Story?             @relation(fields: [storyId], references: [id])
}

model PipelineRun {
  id                   String             @id @default(cuid())
  integrationId        String
  pipelineId           String
  pipelineName         String
  runNumber            Int
  branch               String?
  commitSha            String?
  status               PipelineStatus     @default(IN_PROGRESS)
  triggeredBy          String?
  startedAt            DateTime?
  finishedAt           DateTime?
  durationMs           Int?
  logsUrl              String?
  artifactsUrl         String?
  engineeringProjectId String
  engineeringProject   EngineeringProject @relation(fields: [engineeringProjectId], references: [id], onDelete: Cascade)
  integration          ProjectIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([engineeringProjectId])
}

model SyncJob {
  id                   String              @id @default(cuid())
  integrationId        String?
  provider             IntegrationProvider
  startedAt            DateTime            @default(now())
  finishedAt           DateTime?
  status               SyncStatus          @default(SYNCING)
  itemsProcessed       Int                 @default(0)
  errors               Json?
  durationMs           Int                 @default(0)
  engineeringProjectId String
  engineeringProject   EngineeringProject  @relation(fields: [engineeringProjectId], references: [id], onDelete: Cascade)
  integration          ProjectIntegration? @relation(fields: [integrationId], references: [id])

  @@index([engineeringProjectId])
}

model RepositorySnapshot {
  id                String     @id @default(cuid())
  repositoryId      String
  commitCount       Int        @default(0)
  pullRequestCount  Int        @default(0)
  contributorsCount Int        @default(0)
  openIssuesCount   Int        @default(0)
  closedIssuesCount Int        @default(0)
  starsCount        Int        @default(0)
  forksCount        Int        @default(0)
  size              Int        @default(0)
  capturedAt        DateTime   @default(now())
  repository        Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@index([repositoryId])
  @@index([capturedAt])
}

model ModuleKnowledge {
  id                   String             @id @default(cuid())
  name                 String
  owner                String?
  dependencies         Json?
  dependents           Json?
  healthScore          Float              @default(100.0)
  riskScore            Float              @default(0.0)
  complexityScore      Float?             @default(1.0)
  coverage             Float?             @default(80.0)
  lastModified         DateTime?          @default(now())
  engineeringProjectId String
  engineeringProject   EngineeringProject @relation(fields: [engineeringProjectId], references: [id], onDelete: Cascade)

  @@index([engineeringProjectId])
}

model ProjectKnowledge {
  id                   String             @id @default(cuid())
  projectSummary       String?
  architectureSummary  String?
  riskSummary          String?
  releaseSummary       String?
  engineeringMemory    String?
  engineeringProjectId String             @unique
  engineeringProject   EngineeringProject @relation(fields: [engineeringProjectId], references: [id], onDelete: Cascade)
}

model AIInsight {
  id                   String             @id @default(cuid())
  title                String
  summary              String
  type                 InsightType        @default(SUMMARY)
  severity             InsightSeverity    @default(MEDIUM)
  status               InsightStatus      @default(ACTIVE)
  confidence           Float              @default(90.0)
  resolved             Boolean            @default(false)
  createdBy            String             @default("AI_AGENT")
  expiresAt            DateTime?
  metadata             Json?
  engineeringProjectId String
  createdAt            DateTime           @default(now())
  engineeringProject   EngineeringProject @relation(fields: [engineeringProjectId], references: [id], onDelete: Cascade)

  @@index([engineeringProjectId])
}

model ProjectMetrics {
  id                    String             @id @default(cuid())
  engineeringProjectId  String             @unique
  sprintVelocity        Float              @default(0)
  leadTime              Float              @default(0)
  cycleTime             Float              @default(0)
  deploymentFrequency   Float              @default(0)
  meanReviewTime        Float              @default(0)
  bugRate               Float              @default(0)
  riskScore             Float              @default(0)
  changeFailureRate     Float              @default(0)
  mttr                  Float              @default(0)
  deploymentSuccessRate Float              @default(100.0)
  openRiskCount         Int                @default(0)
  calculatedAt          DateTime           @default(now())
  engineeringProject    EngineeringProject @relation(fields: [engineeringProjectId], references: [id], onDelete: Cascade)
}

model Repository {
  id                       String               @id @default(cuid())
  githubId                 BigInt               @unique
  name                     String
  owner                    String
  fullName                 String
  htmlUrl                  String
  isTracked                Boolean              @default(false)
  webhookEnabled           Boolean              @default(false)
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
  userId                   String
  trackingUserIds          String               @default("")
  lastWebhookEvent         String?
  lastWebhookAt            DateTime?
  displayName              String?
  isArchived               Boolean              @default(false)
  lastSyncedAt             DateTime?
  lastSuccessfulSyncAt     DateTime?
  lastFailedSyncAt         DateTime?
  lastSuccessfulCommitSha  String?
  lastProcessedPullRequest Int?
  syncStatus               String               @default("idle")
  lastSyncError            String?
  syncFailureCount         Int                  @default(0)
  nextAllowedSyncAt        DateTime?
  pollingInterval          Int                  @default(60)
  syncLogs                 BackgroundSyncLog[]
  branches                 Branch[]
  commits                  Commit[]
  engineeringProject       EngineeringProject?
  projectEvents            ProjectEvent[]
  pullRequests             PullRequest[]
  user                     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  snapshots                RepositorySnapshot[]
  webhook                  RepositoryWebhook?
  webhookEvents            WebhookEvent[]
}

model Contributor {
  id             String          @id @default(cuid())
  githubId       BigInt?         @unique
  login          String          @unique
  name           String?
  email          String?
  avatarUrl      String?
  commits        Commit[]
  pullRequests   PullRequest[]
  reviews        Review[]
  reviewComments ReviewComment[]
}

model Commit {
  id            String        @id @default(cuid())
  sha           String        @unique
  message       String
  url           String
  committedAt   DateTime
  repositoryId  String
  contributorId String?
  authorName    String
  authorEmail   String
  authorAvatar  String?
  contributor   Contributor?  @relation(fields: [contributorId], references: [id])
  repository    Repository    @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  files         CommitFile[]
  storyCommits  StoryCommit[]

  @@index([repositoryId])
  @@index([committedAt])
}

model PullRequest {
  id                String             @id @default(cuid())
  githubId          BigInt             @unique
  number            Int
  title             String
  state             String
  url               String
  createdAt         DateTime
  updatedAt         DateTime
  closedAt          DateTime?
  mergedAt          DateTime?
  merged            Boolean            @default(false)
  repositoryId      String
  contributorId     String?
  authorName        String
  authorEmail       String
  authorAvatar      String?
  contributor       Contributor?       @relation(fields: [contributorId], references: [id])
  repository        Repository         @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  files             PullRequestFile[]
  reviews           Review[]
  comments          ReviewComment[]
  storyPullRequests StoryPullRequest[]

  @@index([repositoryId])
  @@index([createdAt])
}

model CommitFile {
  id        String  @id @default(cuid())
  commitId  String
  filename  String
  status    String
  additions Int
  deletions Int
  changes   Int
  patch     String?
  commit    Commit  @relation(fields: [commitId], references: [id], onDelete: Cascade)

  @@index([commitId])
}

model PullRequestFile {
  id            String      @id @default(cuid())
  pullRequestId String
  filename      String
  status        String
  additions     Int
  deletions     Int
  changes       Int
  patch         String?
  pullRequest   PullRequest @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)

  @@index([pullRequestId])
}

model Review {
  id            String          @id @default(cuid())
  githubId      BigInt          @unique
  pullRequestId String
  contributorId String?
  authorName    String
  authorAvatar  String?
  body          String?
  state         String
  submittedAt   DateTime
  contributor   Contributor?    @relation(fields: [contributorId], references: [id])
  pullRequest   PullRequest     @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)
  comments      ReviewComment[]

  @@index([pullRequestId])
}

model ReviewComment {
  id            String       @id @default(cuid())
  githubId      BigInt       @unique
  pullRequestId String
  reviewId      String?
  contributorId String?
  authorName    String
  authorAvatar  String?
  path          String
  line          Int?
  body          String
  diffHunk      String?
  createdAt     DateTime
  updatedAt     DateTime
  contributor   Contributor? @relation(fields: [contributorId], references: [id])
  pullRequest   PullRequest  @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)
  review        Review?      @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([pullRequestId])
  @@index([reviewId])
}

model Branch {
  id           String     @id @default(cuid())
  name         String
  sha          String
  isDefault    Boolean    @default(false)
  isProtected  Boolean    @default(false)
  repositoryId String
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([repositoryId, name])
  @@index([repositoryId])
}

model WebhookEvent {
  id           String      @id @default(cuid())
  repositoryId String?
  eventType    String
  action       String?
  payload      String
  processedAt  DateTime    @default(now())
  repository   Repository? @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@index([repositoryId])
  @@index([processedAt])
}

model RepositoryWebhook {
  id                     String     @id @default(cuid())
  repositoryId           String     @unique
  githubWebhookId        BigInt?
  status                 String     @default("active")
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt
  lastSuccessfulDelivery DateTime?
  lastDeliveryAttempt    DateTime?
  isActive               Boolean    @default(true)
  repository             Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
}

model BackgroundSyncLog {
  id               String      @id @default(cuid())
  repositoryId     String?
  startedAt        DateTime    @default(now())
  completedAt      DateTime?
  syncType         String
  status           String
  commitsProcessed Int         @default(0)
  prsProcessed     Int         @default(0)
  durationMs       Int         @default(0)
  errorMsg         String?
  repository       Repository? @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@index([repositoryId])
  @@index([startedAt])
}

model BackgroundSyncStatus {
  id        String   @id @default("singleton")
  lastRunAt DateTime @default(now())
  status    String   @default("healthy")
  errorMsg  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProjectEvent {
  id                   String              @id @default(cuid())
  provider             IntegrationProvider @default(GITHUB)
  entityType           EventEntityType     @default(COMMIT)
  entityId             String?
  parentEventId        String?
  actorId              String?
  actorName            String
  title                String
  description          String?
  importance           EventImportance     @default(NORMAL)
  source               EventSource         @default(SYSTEM)
  version              Int                 @default(1)
  processingStatus     ProcessingStatus    @default(PENDING)
  processedAt          DateTime?
  metadata             Json
  timestamp            DateTime            @default(now())
  createdAt            DateTime            @default(now())
  engineeringProjectId String?
  repositoryId         String?
  engineeringProject   EngineeringProject? @relation(fields: [engineeringProjectId], references: [id], onDelete: Cascade)
  repository           Repository?         @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@index([engineeringProjectId])
  @@index([repositoryId])
  @@index([timestamp])
  @@index([entityType])
}

enum SyncStatus {
  IDLE
  SYNCING
  SUCCESS
  FAILED
}

enum SprintState {
  FUTURE
  ACTIVE
  CLOSED
}

enum PipelineStatus {
  SUCCESS
  FAILURE
  IN_PROGRESS
  ABORTED
}

enum IntegrationProvider {
  GITHUB
  JIRA
  JENKINS
  SLACK
  SONARQUBE
  GITLAB
  AZURE_DEVOPS
}

enum IntegrationStatus {
  CONNECTED
  DISCONNECTED
  ERROR
}

enum CorrelationMethod {
  BRANCH
  COMMIT
  PR_TITLE
  PR_DESCRIPTION
  MANUAL
  AI
}

enum InsightSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum InsightStatus {
  ACTIVE
  RESOLVED
  IGNORED
}

enum InsightType {
  RISK
  SUMMARY
  BOTTLENECK
  TECH_DEBT
  DEPLOYMENT
  SECURITY
}

enum EventEntityType {
  COMMIT
  PULL_REQUEST
  STORY
  TASK
  SPRINT
  PIPELINE
  AI_INSIGHT
  SYSTEM
}

enum EventImportance {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum EventSource {
  WEBHOOK
  SYNC
  MANUAL
  SYSTEM
}

enum ProcessingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}
