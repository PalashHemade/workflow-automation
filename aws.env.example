# ==============================================================================
# AWS CREDENTIALS TEMPLATE
# Instructions:
# 1. Copy this file to 'aws.env': cp aws.env.example aws.env
# 2. Fill in your AWS credentials below.
# 3. Load them into your terminal session: source aws.env
# ==============================================================================
export AWS_ACCESS_KEY_ID="PASTE_YOUR_AWS_ACCESS_KEY_ID_HERE"
export AWS_SECRET_ACCESS_KEY="PASTE_YOUR_AWS_SECRET_ACCESS_KEY_HERE"
# Optional: AWS Academy / Learner Lab Session Token
export AWS_SESSION_TOKEN="PASTE_YOUR_AWS_SESSION_TOKEN_HERE"
export AWS_DEFAULT_REGION="us-east-1"
