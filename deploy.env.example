# ==============================================================================
# APPLICATION SECRETS TEMPLATE (for EC2 deployment)
# ------------------------------------------------------------------------------
# Instructions:
#   1. Copy this file to 'deploy.env':  cp deploy.env.example deploy.env
#   2. Fill in the SAME real values you already use in your local .env.
#   3. deploy.sh / deploy.ps1 source this automatically — you don't need to
#      `source` it yourself.
#
# These are only ever written into the remote EC2 instance's .env the FIRST
# time it's deployed (a fresh box with no .env yet). Redeploying to an
# already-running box reuses whatever .env is already there and leaves it
# untouched — your local .env is never copied to the server wholesale.
#
# NEXTAUTH_SECRET / NEXTAUTH_URL / APP_URL are handled automatically by the
# pipeline (a fresh secret is generated, and the URL is set to the
# instance's stable Elastic IP) — you don't need to set them here.
# ==============================================================================

# GitHub Developer OAuth App Credentials — required
# Same values as your local .env. Create one at:
# GitHub Settings -> Developer settings -> OAuth Apps
export GITHUB_CLIENT_ID="your-github-client-id"
export GITHUB_CLIENT_SECRET="your-github-client-secret"

# Webhook secret configured on the GitHub repository webhook — required
export GITHUB_WEBHOOK_SECRET="your-webhook-secret"

# Supabase (managed PostgreSQL) connection strings — required
# DIRECT_URL specifically is needed even though it's not always obvious:
# the container runs `prisma migrate deploy` on startup, which requires a
# non-pooled connection. Omitting it will crash-loop the container.
export DATABASE_URL="postgresql://...supabase connection string..."
export DIRECT_URL="postgresql://...supabase direct connection string..."

# AI Agent Framework — Groq + Llama 3.3 70B — optional, leave blank to skip
export GROQ_API_KEY=""

# Jira OAuth 2.0 Credentials — optional, leave blank to skip
export JIRA_CLIENT_ID=""
export JIRA_CLIENT_SECRET=""
